{
  "name": "@teamhub/hub-console",
  "private": true,
  "version": "0.45.72",
  "description": "Team Hub operations console shell",
  "type": "module",
  "scripts": {
    "dev": "npm run build:contracts && vite",
    "build": "npm run build:contracts && tsc -b && vite build",
    "preview": "vite preview",
    "preview:local": "../../scripts/preview-hub-console.sh",
    "build:contracts": "tsc -p ../hub-contracts/tsconfig.json",
    "typecheck": "npm run build:contracts && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build:contracts && vitest run",
    "test:watch": "vitest",
    "health-check": "node e2e/health-check.cjs",
    "e2e:smoke": "node e2e/runner.cjs",
    "verify:all": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@tanstack/react-query": "^5.90.12",
    "@teamhub/hub-contracts": "file:../hub-contracts",
    "@xyflow/react": "^12.11.0",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.61.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
